        <!-- ============ 오른쪽 패널 ============ -->
        <mxCell id="spec-title" value="구성 요약" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1210" y="85" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="spec-box" value="&lt;b&gt;AZ-a · Public&lt;/b&gt;&#10;  · harness (t3.xlarge) — k6 부하 + Prometheus/Grafana/control&#10;&#10;&lt;b&gt;AZ-c · Public&lt;/b&gt;&#10;  · NLB (internal · L4) — SUT 앞단&#10;  · NAT Gateway — private egress&#10;&#10;&lt;b&gt;AZ-c · Private&lt;/b&gt;&#10;  · sut (c6i.large) — Chat Server, 1 vCPU / 2 GiB 제한&#10;  · deps (c6i.xlarge) — PostgreSQL + fake-push ×5&#10;&#10;&lt;b&gt;공통&lt;/b&gt;&#10;  · 단일 k3s 클러스터 (멀티 AZ, flannel VXLAN)&#10;  · SG self-rule 유지 · cAdvisor DaemonSet 전 노드&#10;  · Ubuntu 22.04 · gp3 30GB · Docker Hub pull" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#879196;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="130" width="380" height="360" as="geometry" />
        </mxCell>
        <mxCell id="changes" value="&lt;b&gt;현재 구성 대비 변경점&lt;/b&gt;&#10;① 부하기(harness)를 SUT 와 다른 AZ 배치&#10;    → cross-AZ RTT 반영 (실 클라이언트 유사)&#10;② SUT 를 Private Subnet 으로 이동&#10;    → 인터넷 직접 노출 제거&#10;③ SUT 앞에 NLB(L4) 추가&#10;    → 'LB 거쳐 들어오는' 경로 재현&#10;④ Private egress 용 NAT Gateway 추가&#10;⑤ SSH 는 harness 경유(bastion) / SSM&#10;&#10;&lt;b&gt;트레이드오프&lt;/b&gt;&#10;측정 대상이 서버 + NLB + cross-AZ 로 확장 →&#10;순수 단일서버 성능 측정엔 노이즈 ↑ (L4·저지연이라 ALB 보다는 작음)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D79B00;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1210" y="510" width="380" height="330" as="geometry" />
        </mxCell>
        <mxCell id="operator" value="운영자 / allowed_cidr → IGW&#10;SSH :22 · Grafana :30300 · Control :30800" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7FF;strokeColor=#8C4FFF;fontSize=11;fontStyle=1;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1210" y="860" width="380" height="80" as="geometry" />
        </mxCell>

