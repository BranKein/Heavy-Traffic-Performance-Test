# 서버 설정 (환경변수로 주입). 실제 실행 시 .env 로 복사하거나 export 한다.

SERVER_PORT=8080

# PostgreSQL 접속 (local_dev/docker-compose.yml 기준)
DATABASE_URL=postgres://chat:chat1234@localhost:5432/chat_server

# Fake Push Server (docker-compose 에서 9000 으로 포트포워딩)
PUSH_SERVER_URL=http://localhost:9000

# RSA Public Key (Base64 X.509, RSA-2048). 비우면 config.go 의 샘플 키를 사용 (SR §4).
# JWT_PUBLIC_KEY=

LOG_DIR=./logs

# DB 커넥션 풀 최대 크기 (1 vCPU 환경 기준)
DB_MAX_CONNS=10

# 채팅방 하나당 동시 푸시 상한
PUSH_MAX_CONCURRENCY=64
