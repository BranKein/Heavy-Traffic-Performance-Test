# 서버 포트 (SR: 스프링 구현체와 동일하게 8080)
PORT=8080

# PostgreSQL 접속 정보 (local_dev/docker-compose.yml 기준)
DATABASE_URL=postgres://chat:chat1234@localhost:5432/chat_server

# Fake Push Server (docker-compose: 컨테이너 8090 -> 호스트 9000)
PUSH_SERVER_URL=http://localhost:9000

# 로그 파일 출력 디렉토리 (server.log / error.log)
LOG_DIR=logs

# JWT 검증용 RSA Public Key (Base64 X.509/SPKI, RSA-2048). SR §4 — 외부 주입 가능.
# 스프링 spring_mvc_jpa/application.yaml 의 jwt.public-key 와 동일한 값.
JWT_PUBLIC_
